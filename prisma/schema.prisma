generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Application {
  id          String   @id @default(cuid())
  companyName String
  jobTitle    String
  status      String
  dateApplied String?
  salary      String?
  location    String
  jobUrl      String?
  nextStep    String?
  createdAt   DateTime @default(now())
}
